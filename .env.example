# PeerConnect configuration. Copy this file to .env and fill it in.
# .env is ignored by git; this example is the only one that is tracked.
# An empty value switches that service off. For Google, the two placeholder
# values below are also recognised by the app as "not configured".

# ─── Database ─────────────────────────────────────────────────────────────
# Never root on a server: the app only ever reads and writes rows, so give it
# an account with no CREATE, ALTER or DROP. See DEPLOYMENT.md section 3.
# On cPanel both names come out prefixed with your account, e.g. neusgamo_pc.
DB_HOST=localhost
DB_USER=
DB_PASS=
DB_NAME=cs

# The address the site is actually served at, with the folder if it is not at
# the domain's root. Every link, redirect, asset, emailed link and the app
# manifest is built from this — nothing else names a host or a folder.
#   local XAMPP   http://localhost/case/case
#   live          https://neustpeerconnect.org
# An https:// value also turns on the HTTPS redirect, HSTS and Secure cookies,
# so only set it once HTTPS works on every page. HSTS cannot be withdrawn for
# a year in browsers that have seen it.
APP_URL=http://localhost/case/case

# Salt for the hashed page URLs: any long random string. Every page URL is
# derived from it, so changing it later changes all of them. The Google
# Calendar callback uses a fixed path and is unaffected.
ROUTE_SECRET_KEY=

# ─── Google reCAPTCHA v2 ──────────────────────────────────────────────────
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ─── Google sign-in and Google Calendar ───────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=

# ─── Admin invite key ─────────────────────────────────────────────────────
# Required to create an admin account at admin sign-up. Left empty, sign-up
# rejects every key — it fails closed rather than open.
ADMIN_INVITE_KEY=

# ─── Video calls ──────────────────────────────────────────────────────────
DAILY_API_KEY=
# Optional overrides — helpers.php has a default for each. The private key
# is not in the repository; place it at the path below on each install.
# JAAS_APP_ID=
# JAAS_API_KEY_ID=
# JAAS_PRIVATE_KEY_PATH=App/config/jaas_private_key.pem

# ── Device notifications (Web Push) ──────────────────────────────────────
# Generate ONE pair with `php scripts/vapid_keys.php` and use the same pair on
# every environment: the public key is baked into every browser subscription
# already handed out, so a second pair silently stops those devices receiving
# anything. Left empty, notifications stay in-app and nothing breaks.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Who the push service should contact about our notifications.
VAPID_SUBJECT=https://neustpeerconnect.org

# ─── Scheduled jobs ───────────────────────────────────────────────────────
# Where scripts/backup.php writes and scripts/maintenance.php logs. Keep it
# outside htdocs: the files hold password hashes and scanned student IDs.
# Empty means C:\PeerConnectBackups. See scripts/README.md.
BACKUP_DIR=
# Optional: full path to mysqldump if it is not XAMPP's own copy.
# MYSQLDUMP_PATH=

# ─── Outgoing email ───────────────────────────────────────────────────────
# Email is sent only when SMTP_HOST, SMTP_USERNAME, SMTP_PASSWORD and
# MAIL_FROM are all set; otherwise members get in-app notifications only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=PeerConnect
