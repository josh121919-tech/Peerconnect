# Uploaded files must never be executable. This directory holds user-submitted
# profile photos, verification documents, and report proof images only.

<FilesMatch "\.ph(p[0-9]?|tml|ar)$">
    Require all denied
</FilesMatch>

<IfModule !mod_authz_core.c>
    <FilesMatch "\.ph(p[0-9]?|tml|ar)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# A second lock where PHP runs inside Apache (mod_php, as in XAMPP). On hosts
# that run PHP separately (PHP-FPM) this directive does not exist, and outside
# these guards it made every file in this folder answer with a 500.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
